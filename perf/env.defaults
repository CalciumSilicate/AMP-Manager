: "${PROFILE:=default}"
: "${RESET_ENV:=true}"
: "${KEEP_STACK:=true}"
: "${AMPMANAGER_IMAGE:=ghcr.io/meglinge/amp-manager:latest}"

: "${PERF_APP_PORT:=16823}"
: "${PERF_DB_PORT:=55432}"
: "${PERF_MOCK_PORT:=18080}"
: "${PERF_POSTGRES_USER:=postgres}"
: "${PERF_POSTGRES_PASSWORD:=mysecretpassword}"
: "${PERF_POSTGRES_DB:=ampmanager}"
: "${PERF_COMPOSE_PROJECT_NAME:=ampmanager-perf}"

: "${PERF_JWT_SECRET:=ampmanager-perf-jwt-secret-1234567890-abcdef}"
: "${PERF_UPSTREAM_API_KEY:=perf-upstream-key}"

: "${USER_COUNT:=5000}"
: "${ACTIVE_KEY_POOL:=500}"
: "${BALANCE_MICROS:=100000000}"

: "${PERF_ADMIN_USERNAME:=perf-admin}"
: "${PERF_ADMIN_PASSWORD:=perf-admin-password}"
: "${PERF_USER_PREFIX:=perf-user}"
: "${PERF_USER_PASSWORD:=perf-user-password}"

: "${PUBLIC_CHAT_MODEL:=bench-chat}"
: "${PUBLIC_RESPONSES_MODEL:=bench-responses}"
: "${UPSTREAM_CHAT_MODEL:=bench-chat-upstream}"
: "${UPSTREAM_RESPONSES_MODEL:=bench-responses-upstream}"

: "${PROMPT_CHARS:=1024}"
: "${REQUEST_DETAIL_ENABLED:=true}"

: "${SMOKE_DURATION:=1m}"
: "${NONSTREAM_STEPS_RPM:=600,1200,2000,3000,4500,6000}"
: "${NONSTREAM_STEP_DURATION:=5m}"
: "${STREAM_STEPS_CONCURRENCY:=50,100,200,400,800}"
: "${STREAM_STEP_DURATION:=10m}"
: "${MIXED_STEPS_RPM:=1200,2000,3000,4500,6000}"
: "${MIXED_STEP_DURATION:=5m}"
: "${MIXED_STREAM_SHARE:=0.20}"

: "${K6_HTTP_TIMEOUT:=180s}"
: "${K6_PREALLOCATED_VUS:=256}"
: "${K6_MAX_VUS:=2000}"

: "${PERF_MOCK_NONSTREAM_DELAY_MS:=200}"
: "${PERF_MOCK_STREAM_FIRST_BYTE_DELAY_MS:=300}"
: "${PERF_MOCK_STREAM_CHUNK_DELAY_MS:=750}"
: "${PERF_MOCK_STREAM_CHUNKS:=20}"
: "${PERF_MOCK_CHAT_PROMPT_TOKENS:=128}"
: "${PERF_MOCK_CHAT_COMPLETION_TOKENS:=256}"
: "${PERF_MOCK_RESPONSES_INPUT_TOKENS:=256}"
: "${PERF_MOCK_RESPONSES_OUTPUT_TOKENS:=512}"
: "${PERF_MOCK_ERROR_RATE:=0}"
: "${PERF_MOCK_RETRYABLE_RATE:=0}"
: "${PERF_MOCK_RETRYABLE_STATUS:=429}"
